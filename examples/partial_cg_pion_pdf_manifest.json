{
  "metadata": {
    "run_id": "partial_cg_pion_pdf",
    "root_directory": "..",
    "artifacts_directory": "runs/ds_pdf_partial/artifacts",
    "target_observable": "pdf",
    "parton": "quark",
    "resample_mode": "jk",
    "sample_error_mode": "covariance",
    "bs_samples": 400,
    "bin_size": 1,
    "workers": 8,
    "random_seed": 1984,
    "stages": ["fourier_transform", "perturbative_matching", "review"]
  },
  "inputs": {
    "correlators": [],
    "artifacts": [
      {
        "id": "rn_p5",
        "stage": "renormalization",
        "path": "runs/ds_pdf_complete/artifacts/renormalization/rn_p5.nc",
        "momentum": "PX5PY0PZ0",
        "volume": "S48T64",
        "lattice_spacing_fm": 0.06,
        "hadron": "pion",
        "gfix": "CG"
      }
    ],
    "kernels": [
      {
        "stage": "perturbative_matching",
        "kernel_id": "CG_gt_quark_PDF_hybrid_NLO",
        "kernel_path": "src/lamet_agent/kernels.py",
        "scheme": "hybrid_ratio",
        "kernel_parameters": {}
      }
    ]
  },
  "stages": {
    "fourier_transform": {
      "defaults": {
        "order": ["LA", "NLA"],
        "Lambda0_gev": 0.1,
        "sector": "valence",
        "coord_unit": "lattice",
        "posterior_prior_error_scale": [3.0, 4.0, 5.0],
        "y_grid": {"start": -2.0, "stop": 2.0, "num": 100},
        "scheme_scan": {
          "zmin_values": [12.0, 13.0, 14.0, 15.0],
          "zmax_values": [21.0, 22.0, 23.0, 24.0],
          "z_ext_max": 100.0,
          "smooth": "linear",
          "model_average": false,
          "max_schemes": 200
        }
      },
      "jobs": [
        {"id": "ft_p5", "inputs": {"input": "rn_p5"}}
      ]
    },
    "perturbative_matching": {
      "defaults": {
        "mu": 2.0,
        "component": "re",
        "quasi_y_ls": {"start": -2.0, "stop": 2.0, "num": 100},
        "lc_x_ls": {"start": -2.0, "stop": 2.0, "num": 100}
      },
      "jobs": [
        {"id": "mt_p5", "inputs": {"quasi": "ft_p5"}, "params": {"zs_fm": 0.1722}}
      ]
    },
    "review": {
      "defaults": {},
      "jobs": [
        {"id": "review"}
      ]
    }
  }
}
