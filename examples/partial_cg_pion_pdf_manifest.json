{
  "metadata": {
    "run_id": "partial_cg_pion_pdf",
    "root_directory": "..",
    "artifacts_directory": "runs/ds_pdf_partial/artifacts",
    "target_observable": "pdf",
    "parton": "quark",
    "resample_mode": "jk",
    "random_seed": 1984,
    "stages": ["fourier_transform", "perturbative_matching"]
  },
  "inputs": {
    "correlators": [],
    "artifacts": [
      {
        "id": "rn_p5",
        "stage": "renormalization",
        "path": "runs/ds_pdf_complete/artifacts/renormalization/rn_p5.nc",
        "a_fm": 0.0574,
        "pz_gev": 2.15,
        "hadron": "pion",
        "gfix": "CG"
      }
    ],
    "kernels": [
      {
        "stage": "matching",
        "kernel_id": "CG_gt_PDF_hybrid",
        "kernel_path": "src/lamet_agent/kernels.py",
        "scheme": "hybrid_ratio",
        "kernel_parameters": {"zs_fm": 0.1722}
      }
    ]
  },
  "stages": {
    "fourier_transform": {
      "defaults": {
		"order": ["LA", "NLA"],
        "fit_error_mode": "covariance",
		"sector": "valence",
        "coord_unit": "lattice",
		"posterior_prior_error_scale": [2.0, 3.0, 5.0],
        "y_grid": {"start": -2.0, "stop": 2.0, "num": 100},
        "scheme_scan": {
          "zmin_values": [9.0, 10.0, 11.0, 12.0],
          "zmax_values": [21.0, 22.0, 23.0, 24.0],
          "z_ext_max": 37.0,
          "smooth": "linear",
          "model_average": false,
          "max_schemes": 200
        }
      },
      "jobs": [
        {"id": "ft_p5", "inputs": {"input": "rn_p5"}, "params": {"pz_gev": 2.15}}
      ]
    },
    "perturbative_matching": {
      "defaults": {"mu": 2.0, "component": "re"},
      "jobs": [
        {"id": "mt_p5", "inputs": {"quasi": "ft_p5"}, "params": {"pz_gev": 2.15}}
      ]
    }
  }
}
