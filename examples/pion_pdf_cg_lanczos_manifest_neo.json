{
  "metadata": {
    "run_id": "pion_pdf_cg_lanczos_neo",
    "root_directory": "..",
    "artifacts_directory": "runs/pion_pdf_cg_lanczos_neo/artifacts",
    "random_seed": 1984,
    "workers": 4,
    "target_observable": "pdf",
    "parton": "quark",
    "resample_mode": "jackknife",
    "bin_size": 1,
    "sample_error_mode": "covariance"
  },
  "stages": {
    "correlator_analysis": {
      "defaults": {
        "analysis_method": "lanczos",
        "component": "both",
        "nstate": [
          2
        ],
        "lanczos": {
          "scope": "3pt_matrix",
          "precision": 100
        }
      },
      "jobs": [
        {
          "id": "ca_p0",
          "inputs": {
            "correlators": {
              "file": "examples/pion_pdf_cg_correlators_neo.json"
            }
          },
          "correlator_ids": [
            "p0_2pt",
            "p0_3pt"
          ]
        },
        {
          "id": "ca_p5",
          "inputs": {
            "correlators": {
              "file": "examples/pion_pdf_cg_correlators_neo.json"
            }
          },
          "correlator_ids": [
            "p5_2pt",
            "p5_3pt"
          ]
        }
      ]
    },
    "renormalization": {
      "defaults": {
        "strategy": "external_denominator",
        "normalization": false,
        "external_denominator": {
          "scheme": "hybrid",
          "hybrid": {
            "zs_fm": 0.18,
            "m0_gev": 0.0,
            "delta_m_gev": 0.0
          }
        }
      },
      "jobs": [
        {
          "id": "rn_p5",
          "inputs": {
            "target": "ca_p5",
            "denominator": "ca_p0"
          }
        }
      ]
    },
    "fourier_transform": {
      "defaults": {
        "quasi_y_ls": {
          "start": -2.0,
          "stop": 2.0,
          "num": 200
        },
        "zmin_fm": [
          0.72,
          0.78,
          0.84,
          0.9
        ],
        "zmax_fm": [
          1.26,
          1.32,
          1.38,
          1.44
        ],
        "smooth": "linear",
        "zmax_ext_fm": 1.5,
        "scheme_scan": {
          "order": [
            "LA",
            "NLA"
          ],
          "sector": "valence",
          "Lambda0_gev": 0.1,
          "posterior_prior_error_scale": [
            3.0,
            4.0,
            5.0
          ],
          "model_average": false
        }
      },
      "jobs": [
        {
          "id": "ft_p5",
          "inputs": {
            "input": "rn_p5"
          }
        }
      ]
    },
    "perturbative_matching": {
      "defaults": {
        "kernel_id": "CG_gt_quark_PDF_hybrid_RGR_re_NLO",
        "scheme": "hybrid",
        "mu": 2.0,
        "lc_x_ls": {
          "start": 0.0,
          "stop": 1.0
        },
        "kernel_parameters": {
          "rgr_kappa": 1.0,
          "rgr_mu_min_gev": 0.6
        },
        "hybrid": {
          "zs_fm": 0.18
        }
      },
      "jobs": [
        {
          "id": "mt_p5",
          "inputs": {
            "quasi": "ft_p5"
          }
        }
      ]
    },
    "review": {
      "defaults": {
        "catalog": "builtin",
        "max_papers": 4,
        "report_language": "en",
        "checks": [
          "identity",
          "units",
          "kinematics",
          "schemes",
          "grids",
          "resampling"
        ]
      },
      "jobs": [
        {
          "id": "review",
          "inputs": {
            "results": [
              "ca_p0",
              "ca_p5",
              "rn_p5",
              "ft_p5",
              "mt_p5"
            ]
          }
        }
      ]
    }
  }
}
