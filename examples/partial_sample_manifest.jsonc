{
  // NOTE: JSONC (JSON with comments). Comments document the design; strip them
  // if a strict-JSON parser is required.
  //
  // PARTIAL / RESUME EXAMPLE: start the pipeline from fourier_transform.
  //
  // This is the companion to examples/sample_manifest.jsonc (the full
  // p0+p4+p5 run). It shows how to begin mid-pipeline when the upstream
  // products already exist on disk.
  //
  // Two ingredients make "resume from a middle stage" work:
  //   1. metadata.stages lists ONLY the stages you want to run (order = run order).
  //   2. The first job(s) of the resumed sub-pipeline read their input from an
  //      EXTERNAL SOURCE NODE declared under inputs.artifacts, instead of from
  //      an upstream job id.
  //
  // Reference resolution rule (for any `inputs` value, which is always an id):
  //   1. a job id produced earlier in THIS run (upstream output), else
  //   2. an external source id under inputs.artifacts, else
  //   3. a correlator id under inputs.correlators (first stage only).
  //
  // Here p4 and p5 each resume from their pre-computed renormalized matrix
  // elements, run fourier_transform -> perturbative_matching, and reconverge at
  // the extrapolation placeholder (MERGE POINT).
  // An optional review job uses
  // "defaults": {"literature": true, "literature_max_papers": 4}
  // (literature default false; literature_max_papers default 4).
  // The full optional-parameter catalog lives in examples/sample_manifest.jsonc.
  "metadata": {
    "run_id": "workflow_cg_qpdf_partial_from_fourier",
    "root_directory": "..", // resolve paths from the repository root
    "artifacts_directory": "examples/artifacts", // relative to the root directory; default "artifacts"
    "target_observable": "pdf", // "pdf", "da" or "gpd"
    "parton": "quark", // "quark" or "gluon"
    "resample_mode": "jk", // "jk" or "bs"
    "sample_error_mode": "covariance", // "mean", "median", or "covariance"; "median" requires resample_mode "bs"
    "random_seed": 1984, // required; RNG seed for every resampling step in the run
    "workers": 1, // optional positive integer; sample-fit worker processes (default: 1, serial)
    // "bs_samples": 500, // REQUIRED when resample_mode is "bs"; no default — must be set explicitly
    // "bin_size": 1, // optional; bins configurations before jackknife/bootstrap resampling (default: no binning)
    // Only the stages to run, in execution order. correlator_analysis and
    // renormalization are intentionally absent (their products come in as
    // external source nodes below).
    "stages": ["fourier_transform", "perturbative_matching", "extrapolation"]
  },
  "inputs": {
    // No raw `correlators` here: we are not running the correlator stage.
    // External pre-computed products enter as SOURCE NODES with their own ids,
    // so downstream jobs can reference them uniformly by id.
    "artifacts": [
      {
        "id": "rn_p4", // handle referenced by the fourier job below
        "stage": "renormalization", // which stage this product is equivalent to
        "path": "examples/artifacts/a060_x_p4_renormalized_matrix_elements.nc", // relative to root_directory
        "momentum": "PX4PY0PZ0",
        "volume": "S48T64",
        "lattice_spacing_fm": 0.06,
        "hadron": "pion",
        "gfix": "CG"
      },
      {
        "id": "rn_p5",
        "stage": "renormalization",
        "path": "examples/artifacts/a060_x_p5_renormalized_matrix_elements.nc",
        "momentum": "PX5PY0PZ0",
        "volume": "S48T64",
        "lattice_spacing_fm": 0.06,
        "hadron": "pion",
        "gfix": "CG"
      }
    ],
    "kernels": [
      {
        "stage": "perturbative_matching",
        "kernel_id": "CG_gt_quark_PDF_hybrid_NLO",
        "kernel_path": "lamet_agent/kernels.py", // relative to the root directory
        "kernel_parameters": {} // default {}; fixed kernel-specific values; do not put zs_fm here
      }
    ]
  },
  "stages": {
    "fourier_transform": {
      "defaults": {
        "gfix": "CG", // required here because this partial workflow starts from external artifacts
        "order": ["LA", "NLA"],
        "Lambda0_gev": 0.0,
        "sector": "valence", // quark PDF/GPD: sea/valence/singlet/full; gluon and DA: full
        "hadron": "pion", // explicit because this partial workflow has no correlator provenance
        "polarization": "unpolarized", // explicit because no target 3pt supplies polarization provenance
        "posterior_prior_error_scale": [2.0, 3.0, 5.0],
        "quasi_y_ls": {
          "start": -2.0,
          "stop": 2.0,
          "num": 100
        },
        // Input coordinates and scheme_scan ranges are fixed in fm. Convert lattice
        // indices as z_fm = n * a_fm (a_fm=0.06 below), or omit the three
        // range fields to let the stage auto-fill from the data grid.
        "scheme_scan": {
          "zmin_fm": [0.54, 0.6, 0.66, 0.72],
          "zmax_fm": [1.26, 1.32, 1.38, 1.44],
          "zmax_ext_fm": 6.0,
          "smooth": "linear", // "linear" or "none"; runtime default "linear" if the range keys are auto-filled
          "model_average": false, // runtime default true; false uses one selected tail model
          "max_schemes": 200 // contract default 200; cap accepted range combinations
        }
        // "zmin_shift": 1, // optional; clone low/high tail-window systematics (contract default 0 = off)
        // "component": "re" // "re", "im", or "both" (contract default "both"); cannot combine with sector
      },
      "jobs": [
        {
          "id": "ft_p4",
          "inputs": { "input": "rn_p4" },
          "params": {}
        },
        {
          "id": "ft_p5",
          "inputs": { "input": "rn_p5" },
          "params": {}
        }
      ]
    },
    "perturbative_matching": {
      "defaults": {
        "scheme": "hybrid",
        "mu": 2.0,
        // Matching integrates over the Fourier artifact x grid. lc_x_ls is only
        // the output window on that same spacing. The consumed channel comes from
        // the Fourier artifact attrs.
        "lc_x_ls": {"start": -2.0, "stop": 2.0}
        // "r": 1.4142135623730951, // optional; clone jobs at mu/r and mu*r (contract default 1.0 = off)
        // "rgr_kappa": 1.0, // RGR kernels only; no contract default — unset uses the kernel default 1.0
        // "rgr_mu_min_gev": 0.6, // RGR kernels only; no contract default — unset uses the kernel default 0.6 GeV
        // "sector": "valence", // optional post-match projection; usually inherit from Fourier
      },
      "jobs": [
        {
          "id": "mt_p4",
          "inputs": { "quasi": "ft_p4" }, // from here on, internal job-id references
          "params": { "zs_fm": 0.18 }
        },
        {
          "id": "mt_p5",
          "inputs": { "quasi": "ft_p5" },
          "params": { "zs_fm": 0.18 }
        }
      ]
    },
    "extrapolation": {
      // MERGE POINT: combine matched distributions at several momenta for
      // the large-momentum and continuum extrapolation.
      "defaults": {
        // Central-fit ansatz choices are required; explicit empty order lists are valid.
        "allow_order_a": [2],
        "allow_order_1overp": [2],
        "allow_order_ap": [],
        "fitting_param_xdep": [false, true, false], // [a_xdep, p_xdep, include_ap]
        "posterior_prior_error_scale": 3.0,
        // "pdep_gev": [1.5, 2.0, 2.5],
        // "allow_order_a_sym": [1, 2],
        // "allow_order_1overp_sym": [2],
        // "allow_order_ap_sym": [2, 4]
      },
      "jobs": [
        {
          "id": "ex_pdf",
          "inputs": { "lightcone": ["mt_p4", "mt_p5"] },
          "params": {}
        }
      ]
    }
  }
}
